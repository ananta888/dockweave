{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dockweave.local/schema/mcp-server-contract/v1.json",
  "title": "DockWeave MCP server contract",
  "description": "DockWeave's normalized description of one MCP server. MCP itself defines JSON-RPC methods and per-tool input JSON Schemas, not a single whole-server JSON contract; this schema fills that gap for the graph/connector UI.",
  "type": "object",
  "required": ["name", "transport"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "transport": { "enum": ["stdio", "http", "sse"] },
    "command": { "type": "string" },
    "args": { "type": "array", "items": { "type": "string" } },
    "url": { "type": "string", "format": "uri" },
    "envKeys": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Environment variable names the server expects; values are NOT stored here."
    },
    "protocolVersion": { "type": "string" },
    "capabilities": { "type": "object" },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "inputSchema"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "inputSchema": {
            "type": "object",
            "description": "JSON Schema (draft 2020-12) for the tool input, as returned by tools/list."
          }
        },
        "additionalProperties": false
      }
    },
    "resources": { "type": "array", "items": { "type": "string" } },
    "prompts": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "transport": { "const": "stdio" } } },
      "then": { "required": ["command"] }
    },
    {
      "if": { "properties": { "transport": { "enum": ["http", "sse"] } } },
      "then": { "required": ["url"] }
    }
  ],
  "additionalProperties": false
}
