[Unit]
Description=DockWeave privileged mount helper
Documentation=https://github.com/ananta888/dockweave
After=local-fs.target
Before=dockweaved.service

[Service]
Type=simple
RuntimeDirectory=dockweave
RuntimeDirectoryMode=0770
# The daemon keeps its socket in the same directory; a helper restart must
# not unlink it.
RuntimeDirectoryPreserve=yes
Group=dockweave
ExecStart=/usr/local/bin/dockweave-mountd --socket /run/dockweave/mountd.sock --root /var/lib/dockweave --uid 1001
Restart=on-failure
RestartSec=2

# The helper only performs mount(2)/mount_setattr on fds it receives.
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN
NoNewPrivileges=yes
# No ProtectSystem/PrivateTmp/ProtectKernel*: those create a private mount
# namespace, and mounts made there would never reach the host or the
# containers. The helper must operate in the host mount namespace.
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
