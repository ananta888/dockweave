FROM docker:29.4.3-cli@sha256:51e23845f5caff1e688a2fae003b0c69d635c9200ad544731db1593731df1d3a AS dockercli
FROM golang:1.27.3-bookworm@sha256:dc0963f32053e4bc451d24d87e3892d42d01021b61f093e98eb95c0352bb84b0
ENV GOTOOLCHAIN=local
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
# python3 runs the Paperclip wrapper helpers in the wrapper end-to-end test.
# nftables: egress tests, enabled only in CI (see scripts/test-integration.sh).
RUN apt-get update && apt-get install -y --no-install-recommends python3 nftables \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
