{
  "realm": "dockweave",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "accessTokenLifespan": 3600,
  "clients": [
    {
      "clientId": "dockweave",
      "name": "DockWeave Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8790/oauth/callback",
        "http://localhost:8790/oauth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:8790",
        "http://localhost:8790"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "dockweave-admin"
    },
    {
      "name": "dockweave-monitor"
    }
  ],
  "defaultRoles": [
    "offline_access",
    "uma_authorization",
    "default-roles-dockweave"
  ],
  "users": [
    {
      "username": "krusty",
      "enabled": true,
      "email": "krusty@dockweave.local",
      "emailVerified": true,
      "firstName": "Krusty",
      "lastName": "Hauptadmin",
      "groups": [
        "dockweave-admin"
      ]
    },
    {
      "username": "user",
      "enabled": true,
      "email": "user@dockweave.local",
      "emailVerified": true,
      "groups": [],
      "firstName": "Standard",
      "lastName": "User"
    },
    {
      "username": "monitor",
      "enabled": true,
      "email": "monitor@dockweave.local",
      "emailVerified": true,
      "groups": [
        "dockweave-monitor"
      ],
      "firstName": "Monitor",
      "lastName": "User"
    }
  ]
}
