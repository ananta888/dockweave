{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dockweave.local/schemas/todo.legacy.schema.json",
  "title": "Historic DockWeave domain tasks",
  "type": "object",
  "required": ["domain", "updated", "tasks"],
  "properties": {
    "domain": {"type": "string", "minLength": 1},
    "updated": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["pending", "in_progress", "done", "blocked", "deferred"]},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "acceptance": {"type": "string"}
        }
      }
    }
  }
}
